# iOS release automation.
#
# `beta` builds a signed IPA and uploads it to TestFlight. Signing material and
# App Store Connect API credentials are injected via environment variables set
# by the GitHub Actions release workflow (see .github/workflows/release.yml):
#
#   BUILD_CERTIFICATE_BASE64      distribution .p12, base64-encoded
#   P12_PASSWORD                  password for that .p12
#   PROVISIONING_PROFILE_BASE64   App Store .mobileprovision, base64-encoded
#   KEYCHAIN_PASSWORD             throwaway password for the temp CI keychain
#   ASC_KEY_ID / ASC_ISSUER_ID    App Store Connect API key identifiers
#   ASC_KEY_P8_BASE64             the API key .p8, base64-encoded
#
# The Flutter build itself is run by the workflow before fastlane; fastlane
# here only re-signs/archives via gym and uploads.

default_platform(:ios)

APP_IDENTIFIER = "com.scansignsend.scanSignSend"

platform :ios do
  desc "Build a signed IPA and upload to TestFlight"
  lane :beta do
    setup_ci

    # ── Import signing material into a temporary keychain ──────────────────
    import_signing_material

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_KEY_P8_BASE64"]),
      is_key_content_base64: false,
      in_house: false,
    )

    profile_name = ENV["PROVISIONING_PROFILE_NAME"] || "ScanSignSend App Store"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      configuration: "Release",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
        signingStyle: "manual",
      },
      output_directory: ENV["IPA_OUTPUT_DIR"] || "./build",
      output_name: "ScanSignSend.ipa",
      clean: true,
      # Flutter already ran `flutter build ios --release --no-codesign`, so the
      # generated project is present. gym archives + signs it.
      skip_profile_detection: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  # Imports the distribution certificate and provisioning profile from the
  # base64 secrets into an ephemeral keychain so gym can sign with them.
  private_lane :import_signing_material do
    require "fileutils"
    require "base64"

    keychain_name = "ci-signing.keychain-db"
    keychain_password = ENV["KEYCHAIN_PASSWORD"] || "ci-temp-password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    cert_path = "/tmp/dist_cert.p12"
    File.binwrite(cert_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"]))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV["P12_PASSWORD"],
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Install the provisioning profile where Xcode expects it.
    profiles_dir = File.expand_path(
      "~/Library/MobileDevice/Provisioning Profiles"
    )
    FileUtils.mkdir_p(profiles_dir)
    profile_data = Base64.decode64(ENV["PROVISIONING_PROFILE_BASE64"])
    File.binwrite(
      File.join(profiles_dir, "ci_profile.mobileprovision"),
      profile_data,
    )
  end
end
