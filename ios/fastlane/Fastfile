# iOS release automation.
#
# `beta` builds a signed IPA and uploads it to TestFlight. Signing material and
# App Store Connect API credentials are injected via environment variables set
# by the GitHub Actions release workflow (see .github/workflows/release.yml):
#
#   BUILD_CERTIFICATE_BASE64      distribution .p12, base64-encoded
#   P12_PASSWORD                  password for that .p12
#   PROVISIONING_PROFILE_BASE64   App Store .mobileprovision, base64-encoded
#   KEYCHAIN_PASSWORD             throwaway password for the temp CI keychain
#   ASC_KEY_ID / ASC_ISSUER_ID    App Store Connect API key identifiers
#   ASC_KEY_P8_BASE64             the API key .p8, base64-encoded
#
# The Flutter build itself is run by the workflow before fastlane; fastlane
# here only re-signs/archives via gym and uploads.

default_platform(:ios)

APP_IDENTIFIER = "com.adakVentures.scanSignSend"

platform :ios do
  desc "Build a signed IPA and upload to TestFlight"
  lane :beta do
    setup_ci

    # ── Import signing material into a temporary keychain ──────────────────
    import_signing_material

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_KEY_P8_BASE64"]),
      is_key_content_base64: false,
      in_house: false,
    )

    profile_name = ENV["PROVISIONING_PROFILE_NAME"] || "ScanSignSend App Store"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      configuration: "Release",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
        signingStyle: "manual",
      },
      output_directory: ENV["IPA_OUTPUT_DIR"] || "./build",
      output_name: "ScanSignSend.ipa",
      clean: true,
      # Flutter already ran `flutter build ios --release --no-codesign`, so the
      # generated project is present. gym archives + signs it.
      skip_profile_detection: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  # ── Local releases from the developer's Mac (scripts/release.sh) ────────
  # Signing uses the Mac's own keychain (Apple Distribution certificate for
  # team T995T8G6Z2, automatic signing); the IPA is built beforehand by
  # `flutter build ipa`. App Store Connect API key from the environment:
  #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to AuthKey_<id>.p8)
  desc "Upload an IPA built on this Mac to TestFlight (internal testers)"
  lane :local_testflight do
    upload_to_testflight(
      api_key: local_api_key,
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  # Store listing for the version in pubspec.yaml: metadata (7 languages,
  # generated by scripts/appstore_metadata.py) and screenshots (generated by
  # tool/store_capture/frame.py). Creates the version in App Store Connect if
  # needed. Never uploads a binary and never submits for review — pick the
  # build and press Submit in App Store Connect. The app preview video is not
  # supported by deliver; upload it by hand.
  desc "Upload App Store metadata + screenshots for the pubspec version (no submit)"
  lane :listing do
    version = File.read("../../pubspec.yaml")[/^version:\s*([\d.]+)/, 1]
    deliver(
      api_key: local_api_key,
      app_version: version,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_app_version_update: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true, # skip the HTML preview prompt
    )
  end

  # Submits the pubspec version + build for review, auto-releasing on approval.
  # Metadata and screenshots must already be uploaded (`listing`).
  desc "Submit the pubspec version/build for App Store review (auto-release)"
  lane :submit do
    pubspec = File.read("../../pubspec.yaml")
    version = pubspec[/^version:\s*([\d.]+)/, 1]
    build = pubspec[/^version:\s*[\d.]+\+(\d+)/, 1]
    deliver(
      api_key: local_api_key,
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      # Not skip_metadata: deliver sends the release type with the metadata,
      # so skipping it left 1.0.1 on manual release.
      metadata_path: "./fastlane/metadata",
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false },
      run_precheck_before_submit: false,
      force: true,
    )
  end

  private_lane :local_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false,
    )
  end

  # Imports the distribution certificate and provisioning profile from the
  # base64 secrets into an ephemeral keychain so gym can sign with them.
  private_lane :import_signing_material do
    require "fileutils"
    require "base64"

    keychain_name = "ci-signing.keychain-db"
    keychain_password = ENV["KEYCHAIN_PASSWORD"] || "ci-temp-password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    cert_path = "/tmp/dist_cert.p12"
    File.binwrite(cert_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"]))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV["P12_PASSWORD"],
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Install the provisioning profile where Xcode expects it.
    profiles_dir = File.expand_path(
      "~/Library/MobileDevice/Provisioning Profiles"
    )
    FileUtils.mkdir_p(profiles_dir)
    profile_data = Base64.decode64(ENV["PROVISIONING_PROFILE_BASE64"])
    File.binwrite(
      File.join(profiles_dir, "ci_profile.mobileprovision"),
      profile_data,
    )
  end
end
