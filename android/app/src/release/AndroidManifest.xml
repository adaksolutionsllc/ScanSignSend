<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No network at all: the app works offline and sends nothing. ML Kit
         adds these to send usage metrics to Google; removing them stops it.
         Billing, Block Store and the scanner talk to Google Play services on
         the phone, outside this app. Release only: debug and profile builds
         need INTERNET for the Flutter tool (src/debug, src/profile). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
