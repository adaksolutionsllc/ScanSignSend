<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules.

  Backup is OPT-IN. Whether anything is backed up or transferred at all is
  decided at runtime by AppBackupAgent, which writes nothing unless the user
  has switched on "Include in device backup" in Settings. These rules only
  describe what goes in once they have:

  - cloud-backup: everything, but only when the backup is end-to-end
    encrypted with the device's screen lock. Without a screen lock, nothing
    reaches Google Drive even with the setting on.
  - device-transfer: everything (a direct phone-to-phone copy).

  The cache (including rendered PDF page previews) is never backed up.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
