# Android release automation.
#
# `internal` uploads the app bundle built by CI to the Play Console "Internal
# testing" track. Promote to production from the Play Console once verified.
#
# Auth: a Google Play service-account JSON, provided at runtime via the
# PLAY_SERVICE_ACCOUNT_JSON secret (written to a temp file by the workflow) and
# referenced through the GOOGLE_PLAY_JSON_KEY env var.

default_platform(:android)

platform :android do
  desc "Upload the AAB to the Play Store internal testing track"
  lane :internal do
    upload_to_play_store(
      package_name: "com.adakventures.scansignsend",
      track: "internal",
      aab: ENV["AAB_PATH"] || "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # Release notes ("What's new") from metadata/android/<locale>/
      # changelogs/<versionCode>.txt, written by scripts/play_release_notes.py.
      metadata_path: "./fastlane/metadata/android",
      skip_upload_changelogs: false,
    )
  end

  # Store listing text in every language (title, short and full
  # description), written by scripts/play_listing.py from store/listings.
  # No build, no release notes, no graphics. VALIDATE_ONLY=1 checks the edit
  # with Google Play without saving it.
  desc "Upload the Play store listing text (all languages)"
  lane :play_listing do
    build = File.read("../../pubspec.yaml")[/^version:\s*[\d.]+\+(\d+)/, 1]
    upload_to_play_store(
      package_name: "com.adakventures.scansignsend",
      # supply attaches listing uploads to a release; the live one.
      track: "production",
      version_code: build.to_i,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      metadata_path: "./fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: ENV["VALIDATE_ONLY"] == "1",
    )
  end

  # Phone screenshots in every language, framed by
  # tool/store_capture/frame.py into metadata/android/<locale>/images/
  # phoneScreenshots (each language's set replaces what Play has). Nothing
  # else. VALIDATE_ONLY=1 checks the edit without saving it.
  desc "Upload the Play phone screenshots (all languages)"
  lane :play_screenshots do
    build = File.read("../../pubspec.yaml")[/^version:\s*[\d.]+\+(\d+)/, 1]
    upload_to_play_store(
      package_name: "com.adakventures.scansignsend",
      track: "production",
      version_code: build.to_i,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      metadata_path: "./fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      validate_only: ENV["VALIDATE_ONLY"] == "1",
    )
  end

  desc "Promote the pubspec build from internal to production (manual)"
  lane :promote_to_production do
    # Name the build explicitly: with a draft newer release on internal,
    # supply promoted the older completed one (build 8 instead of 9).
    build = File.read("../../pubspec.yaml")[/^version:\s*[\d.]+\+(\d+)/, 1]
    upload_to_play_store(
      package_name: "com.adakventures.scansignsend",
      track: "internal",
      track_promote_to: "production",
      version_code: build.to_i,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # The release notes go onto the release being promoted.
      metadata_path: "./fastlane/metadata/android",
      skip_upload_changelogs: false,
    )
  end
end
